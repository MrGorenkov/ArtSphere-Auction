@startuml ArtSphere_State_Auction
' ============================================================
' ArtSphere Auction — Диаграмма состояний
' Состояния аукциона
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 12
skinparam state {
    BackgroundColor #FDFDFD
    BorderColor #2E2E2E
    FontName "Times New Roman"
    FontSize 12
    ArrowColor #3D3D3D
    StartColor #2E2E2E
    EndColor #2E2E2E
}

[*] --> Upcoming : создание аукциона\n(start_time в будущем)

state "Upcoming\n«Ожидает начала»" as Upcoming {
    Upcoming : entry / сохранить в БД,\n status = upcoming
    Upcoming : do / ожидание\n наступления start_time
}

state "Active\n«Активен»" as Active {
    Active : entry / статус = active,\n рассылка push-уведомлений
    Active : do / приём ставок,\n трансляция через WebSocket
    Active : exit / фиксация\n финального снимка

    state "AcceptingBids\n«Принимает ставки»" as AcceptingBids
    state "LastMinute\n«Последняя минута»" as LastMinute

    [*] --> AcceptingBids
    AcceptingBids --> LastMinute : timeRemaining < 60c
    LastMinute --> AcceptingBids : новая ставка\n(продление\nна 60c)
}

state "Ended\n«Завершён\nбез покупки»" as Ended {
    Ended : entry / status = ended
    Ended : do / уведомить автора\n и участников
}

state "Sold\n«Продан»" as Sold {
    Sold : entry / status = sold,\n определить победителя
    Sold : do / создать транзакцию,\n передать NFT
    Sold : exit / отправить\n финальные уведомления
}

state "Cancelled\n«Отменён»" as Cancelled {
    Cancelled : entry / status = cancelled
    Cancelled : do / возврат ставок\n участникам
}

Upcoming --> Active   : наступило start_time
Upcoming --> Cancelled : отмена автором\nдо старта

Active --> Sold       : end_time И есть ставки\nИ резерв достигнут
Active --> Ended      : end_time И (нет ставок\nИЛИ резерв не достигнут)
Active --> Cancelled  : отмена администратором\n/ нарушение правил

Sold --> [*]
Ended --> [*]
Cancelled --> [*]

note right of Active
  Переходы внутри Active
  реализуют механизм
  антиснайпинга:
  продление на 60c
  при ставке в последнюю
  минуту.
end note

note bottom of Sold
  Переход в Sold запускает
  пайплайн минтинга NFT
  и обновление владельца
  в таблице nft_tokens.
end note

@enduml
