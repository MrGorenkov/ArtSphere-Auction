@startuml ArtSphere_Activity_Auction
' ============================================================
' ArtSphere Auction — Диаграмма деятельности
' Жизненный цикл аукциона
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 10
skinparam activity {
    BackgroundColor #FDFDFD
    BorderColor #2E2E2E
    FontName "Times New Roman"
    DiamondBackgroundColor #FFF8E8
    DiamondBorderColor #7A6A2A
    StartColor #2E2E2E
    EndColor #2E2E2E
    ArrowColor #3D3D3D
}
skinparam partition {
    BorderColor #6C7A96
    FontName "Times New Roman"
    FontStyle bold
}

|Автор|
start
:Загрузить произведение\n(изображение, 3D-модель);
:Заполнить метаданные\n(название, описание, стиль);
:Указать параметры аукциона\n(стартовая цена, шаг,\nдлительность, резерв);
:Опубликовать аукцион;

|Система|
:Сохранить запись\nв таблице auctions (status = upcoming);
:Запланировать старт\n(start_time);

if (start_time наступило?) then (да)
    :Перевести status → active;
    :Разослать push\n«Аукцион начался»\nподписчикам автора;
else (нет)
endif

|Покупатель|
repeat
    :Просмотреть карточку\nи 3D-превью;
    if (Решил участвовать?) then (да)
        :Ввести сумму ставки;
        if (Сеть доступна?) then (да)
            |Система|
            :Проверить: amount ≥ currentBid + bidStep;
            if (Валидна?) then (да)
                :Записать ставку в БД;
                :Обновить current_bid,\nbid_count;
                :Опубликовать через WebSocket\nи APNs;
            else (нет)
                :Вернуть ошибку\n«bid_too_low»;
                |Покупатель|
                :Показать сообщение\nоб ошибке;
            endif
        else (нет)
            |Покупатель|
            :Сохранить ставку\nв BidQueueService;
            :Пометить как «ожидает\nсинхронизации»;
            :При восстановлении сети\nотправить POST /sync/bids;
        endif
    else (нет)
        :Наблюдать\nза ходом торгов;
    endif
repeat while (end_time не наступило?) is (да)
->нет;

|Система|
if (Есть ставки?) then (да)
    if (Резерв достигнут?) then (да)
        :Определить победителя\n(highest bid);
        :status → sold;
        :Создать транзакцию\n(buyer, seller, amount);
        :Передать NFT\nпобедителю;
        :Уведомить всех\nучастников;
    else (нет)
        :status → ended\n(резерв не достигнут);
        :Уведомить автора\nи участников;
    endif
else (нет)
    :status → ended\n(нет ставок);
    :Уведомить автора;
endif

stop

@enduml
