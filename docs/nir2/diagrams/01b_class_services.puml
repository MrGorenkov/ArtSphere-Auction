@startuml ArtSphere_ServiceLayer
' ============================================================
' ArtSphere Auction — Диаграмма классов (сервисный слой iOS)
' ============================================================

skinparam backgroundColor #FFFFFF
skinparam classFontName "Times New Roman"
skinparam classFontSize 12
skinparam defaultFontName "Times New Roman"
skinparam shadowing false
skinparam roundCorner 6
skinparam class {
    BackgroundColor #FDFDFD
    BorderColor #2E2E2E
    ArrowColor #2E2E2E
    HeaderBackgroundColor #E8EEF7
}
skinparam package {
    BackgroundColor #F6F8FC
    BorderColor #6C7A96
}
hide empty members
skinparam nodesep 45
skinparam ranksep 55

package "Сервисный слой iOS" <<Frame>> {

    class AuthService <<Сервис_аутентификации>> {
        -tokenStorage : Хранилище_токена_Keychain
        -currentUser : Текущий_пользователь
        --
        +войти(email, пароль) : User
        +зарегистрировать(данные) : User
        +выйти() : Void
        +текущийТокен() : String
    }

    class NetworkService <<Сервис_сетевых_запросов>> {
        -baseURL : Базовый_URL
        -session : URLSession
        --
        +запрос<T>(endpoint) : T
        +запросБезОтвета(endpoint) : Void
        +загрузить(данные, endpoint) : URL
    }

    class WebSocketService <<Сервис_WebSocket>> {
        -socket : Сокет
        -reconnectAttempts : Попытки_переподключения
        --
        +подключить(url) : Void
        +отправить(сообщение) : Void
        +приПолучении(обработчик) : Void
    }

    class AuctionService <<Сервис_аукционов>> {
        -mode : Режим_работы
        -webSocket : WebSocketService
        -bidQueue : BidQueueService
        --
        +загрузитьАукционы() : [Auction]
        +сделатьСтавку(idАукциона, сумма) : Bid
        +подписатьсяНаОбновления(idАукциона) : Void
        +переключитьРежим(онлайн) : Void
    }

    class BidQueueService <<Очередь_офлайн_ставок>> {
        -pendingBids : Ожидающие_ставки
        -pathMonitor : Монитор_сети_NWPathMonitor
        -maxRetries : Максимум_попыток
        --
        +добавитьВОчередь(ставка) : Void
        +синхронизировать() : Void
        -экспоненциальнаяЗадержка(попытка) : TimeInterval
        +обработатьИзмененияСети() : Void
    }

    class NotificationService <<Сервис_уведомлений>> {
        -apnsToken : Токен_APNs
        --
        +получитьУведомления() : [Notification]
        +пометитьПрочитанным(id) : Void
        +зарегистрироватьТокенУстройства(token) : Void
    }

    class AnalyticsService <<Сервис_аналитики>> {
        +логировать(событие, параметры) : Void
        +установитьСвойство(ключ, значение) : Void
    }
}

package "Предметная модель" <<Frame>> {
    class User <<Пользователь>>
    class Auction <<Аукцион>>
    class Bid <<Ставка>>
    class Notification <<Уведомление>>
}

' Внутренние связи сервисов
AuctionService --> NetworkService : использует
AuctionService --> WebSocketService : использует
AuctionService --> BidQueueService : делегирует\nпри офлайн
BidQueueService --> NetworkService : синхронизирует\nпри восстановлении сети
AuthService --> NetworkService : использует
NotificationService --> NetworkService : использует

' Сервисы → предметная модель
AuthService ..> User : управляет
AuctionService ..> Auction : управляет
AuctionService ..> Bid : создаёт
NotificationService ..> Notification : управляет

@enduml
